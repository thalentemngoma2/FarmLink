    "axios": "^1.14.0",
    "babel-preset-expo": "^52.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "expo": "^56.0.5",
    "expo-asset": "~56.0.15",
    "expo-audio": "~56.0.11",
